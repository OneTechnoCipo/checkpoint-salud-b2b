generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Usuario {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  rol          RolUsuario
  nombre       String?    @db.VarChar(100)
  apellido     String?    @db.VarChar(100)
  activo       Boolean    @default(true)
  empresaId    String?    @map("empresa_id") @db.Uuid
  creadoEn     DateTime   @default(now()) @map("creado_en")
  pacienteId   String?    @unique @map("paciente_id") @db.Uuid
  empresa      Empresa?   @relation(fields: [empresaId], references: [id])
  paciente     Paciente?  @relation(fields: [pacienteId], references: [id])

  @@map("usuarios")
}
model Empresa {
  id          String            @id @default(uuid()) @db.Uuid
  razonSocial String            @map("razon_social") @db.VarChar(255)
  cuit        String            @unique @db.VarChar(20)
  pacientes   Paciente[]
  puestos     PuestoRequisito[]
  usuarios    Usuario[]

  @@map("empresas")
}

model PuestoRequisito {
  id            String     @id @default(uuid()) @db.Uuid
  nombrePuesto  String     @map("nombre_puesto") @db.VarChar(150)
  mesesVigencia Int        @map("meses_vigencia")
  empresaId     String     @map("empresa_id") @db.Uuid
  pacientes     Paciente[]
  empresa       Empresa    @relation(fields: [empresaId], references: [id])

  @@unique([nombrePuesto, empresaId])
  @@map("puestos_requisitos")
}

model Sede {
  id          String           @id @default(uuid()) @db.Uuid
  nombre      String           @db.VarChar(150)
  direccion   String           @db.VarChar(255)
  solicitudes SolicitudTurno[]
  turnos      Turno[]

  @@map("sedes")
}

model Paciente {
  id          String           @id @default(uuid()) @db.Uuid
  dni         String           @unique @db.VarChar(20)
  nombre      String           @db.VarChar(100)
  apellido    String           @db.VarChar(100)
  empresaId   String           @map("empresa_id") @db.Uuid
  puestoId    String           @map("puesto_id") @db.Uuid
  aptos       AptoMedico[]
  empresa     Empresa          @relation(fields: [empresaId], references: [id])
  puesto      PuestoRequisito  @relation(fields: [puestoId], references: [id])
  solicitudes SolicitudTurno[]
  turnos      Turno[]
  usuario     Usuario?

  @@map("pacientes")
}

model Turno {
  id         String          @id @default(uuid()) @db.Uuid
  fechaHora  DateTime        @map("fecha_hora")
  estado     EstadoTurno     @default(PENDIENTE)
  pacienteId String          @map("paciente_id") @db.Uuid
  sedeId     String          @map("sede_id") @db.Uuid
  apto       AptoMedico?
  solicitud  SolicitudTurno?
  paciente   Paciente        @relation(fields: [pacienteId], references: [id])
  sede       Sede            @relation(fields: [sedeId], references: [id])

  @@map("turnos")
}

model AptoMedico {
  id               String        @id @default(uuid()) @db.Uuid
  fechaEmision     DateTime?     @map("fecha_emision") @db.Date
  fechaVencimiento DateTime?     @map("fecha_vencimiento") @db.Date
  estadoAptitud    EstadoAptitud @default(PENDIENTE) @map("estado_aptitud")
  detalleClinico   String?       @map("detalle_clinico")
  documentoUrl     String?       @map("documento_url") @db.VarChar(500)
  turnoId          String?       @unique @map("turno_id") @db.Uuid
  pacienteId       String        @map("paciente_id") @db.Uuid
  paciente         Paciente      @relation(fields: [pacienteId], references: [id])
  turno            Turno?        @relation(fields: [turnoId], references: [id])

  @@map("aptos_medicos")
}

model SolicitudTurno {
  id             String               @id @default(uuid()) @db.Uuid
  fechaPreferida DateTime             @map("fecha_preferida") @db.Date
  estado         EstadoSolicitudTurno @default(PENDIENTE)
  pacienteId     String               @map("paciente_id") @db.Uuid
  sedeId         String               @map("sede_id") @db.Uuid
  turnoId        String?              @unique @map("turno_id") @db.Uuid
  paciente       Paciente             @relation(fields: [pacienteId], references: [id])
  sede           Sede                 @relation(fields: [sedeId], references: [id])
  turno          Turno?               @relation(fields: [turnoId], references: [id])

  @@map("solicitudes_turnos")
}

enum RolUsuario {
  CLINICA
  EMPRESA
  ADMIN
  PACIENTE
}

enum EstadoTurno {
  PENDIENTE
  ASISTIO
  CANCELADO
}

enum EstadoSolicitudTurno {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
}

enum EstadoAptitud {
  APTO
  NO_APTO
  PENDIENTE
  APTO_CON_OBSERVACIONES
}
